{
  "expo": {
    "name": "FitWit",
    "slug": "fit-wit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.suhai.fitwit",
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE"
      ]
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1d3c3ebd-11d5-4d93-98b2-199da11eda30"
      }
    },
    "owner": "suhailk241"
  }
}
